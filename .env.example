# .env.example — Simple Voice Interface
# Copy this file to .env and fill in all required values.
# Lines marked REQUIRED must be set before the application will start.
# Lines marked OPTIONAL will fall back to the shown default if omitted.

# ─── Deepgram Speech-to-Text ─────────────────────────────────────────────────

# REQUIRED — Deepgram API key. Get one free at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_key_here

# OPTIONAL — Deepgram model name (default: nova-2)
DEEPGRAM_MODEL=nova-2

# ─── Text-to-Speech ───────────────────────────────────────────────────────────

# OPTIONAL — TTS provider: "elevenlabs" or "cartesia" (default: elevenlabs)
TTS_PROVIDER=elevenlabs

# REQUIRED — API key for the chosen TTS provider
TTS_API_KEY=your_tts_api_key_here

# REQUIRED — Voice ID to use (find in your provider's dashboard or voice library)
# ElevenLabs example: 21m00Tcm4TlvDq8ikWAM  (Rachel — free tier voice)
# Cartesia example:   a0e99841-438c-4a64-b679-ae501e7d6091
TTS_VOICE_ID=your_voice_id_here

# ─── LLM Agent — Phase 1 ─────────────────────────────────────────────────────

# OPTIONAL — Base URL for OpenAI-compatible LLM API (default: OpenAI)
# Override to point at a local model (e.g. http://localhost:11434/v1 for Ollama)
LLM_API_BASE=https://api.openai.com/v1

# REQUIRED — API key for the LLM provider
LLM_API_KEY=your_llm_api_key_here

# OPTIONAL — Model name to use (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# OPTIONAL — System prompt sent at the start of every conversation
LLM_SYSTEM_PROMPT=You are a helpful voice assistant. Be concise. Your responses will be spoken aloud.

# OPTIONAL — Max conversation turns kept in rolling history (default: 20)
# System prompt is always preserved regardless of this limit.
LLM_MAX_HISTORY_TURNS=20

# ─── Audio ────────────────────────────────────────────────────────────────────

# OPTIONAL — Microphone sample rate in Hz (default: 16000)
# Do not change unless your STT provider requires a different rate.
SAMPLE_RATE=16000

# OPTIONAL — Audio frame duration in milliseconds (default: 20)
# webrtcvad accepts only 10, 20, or 30. chunk_size is derived automatically.
CHUNK_MS=20

# ─── Voice Activity Detection ─────────────────────────────────────────────────

# OPTIONAL — webrtcvad aggressiveness: 0 (least) to 3 (most) (default: 2)
# Increase if background noise causes false interrupts; decrease if speech is missed.
VAD_AGGRESSIVENESS=2

# OPTIONAL — Milliseconds of continuous silence that ends an utterance (default: 600)
SILENCE_DURATION_MS=600

# ─── Logging ──────────────────────────────────────────────────────────────────

# OPTIONAL — Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# Set to DEBUG to see per-frame audio events (very noisy).
LOG_LEVEL=INFO
